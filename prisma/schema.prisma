generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  abbreviation String             @unique
  createdAt    DateTime           @default(now()) @map("created_at")
  programs     Program[]
  clusterSlots ClusterDepartment[]
}

model Program {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
}

model Cluster {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  description       String              @default("")
  capacity          Int
  currentEnrolled   Int                 @default(0) @map("current_enrolled")
  location          String              @default("")
  locationId        Int?                @map("location_id")
  locationRef       Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now()) @map("created_at")
  staff             Staff[]
  allowedDepartments ClusterDepartment[]
  phases            Phase[]
  announcements     Announcement[]
  venues            Venue[]
  groups            Group[]
  staffTransferRequestsFrom StaffTransferRequest[] @relation("staffFromCluster")
  staffTransferRequestsTo StaffTransferRequest[] @relation("staffToCluster")
  phaseAllocations      PhaseAllocation[]
}

model Location {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  clusters  Cluster[]
}

model ClusterDepartment {
  clusterId    Int        @map("cluster_id")
  departmentId Int        @map("department_id")
  slots        Int        @default(0)
  enrolled     Int        @default(0)
  cluster      Cluster    @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([clusterId, departmentId])
}

model Staff {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?   @unique
  password           String
  role               String    @default("staff")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  status             String    @default("active")
  department         String?
  clusterId          Int?      @map("cluster_id")
  cluster            Cluster?  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now()) @map("created_at")
  announcements      Announcement[]
  transferRequests   StaffTransferRequest[]
  announcementReads  StaffAnnouncementRead[]
}

model Student {
  id                       Int            @id @default(autoincrement())
  studentId                String         @unique @map("student_id")
  fullName                 String         @map("full_name")
  department               String
  program                  String
  email                    String         @unique
  password                 String
  role                     String         @default("student")
  mustChangePassword       Boolean        @default(false) @map("must_change_password")
  status                   String         @default("pending_activation")
  temporaryPasswordExpiresAt DateTime?    @map("temporary_password_expires_at")
  createdAt                DateTime       @default(now()) @map("created_at")
  applications             Application[]
  announcementReads        AnnouncementRead[]
}

model Admin {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  email              String   @unique
  phone              String?  @unique
  password           String
  role               String   @default("admin")
  status             String   @default("active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
}

model IptSession {
  id            Int      @id @default(autoincrement())
  name          String
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  weeksPerPhase Int      @default(5) @map("weeks_per_phase")
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  phases        Phase[]
}

model Phase {
  id          Int              @id @default(autoincrement())
  sessionId   Int              @map("session_id")
  session     IptSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phaseNumber Int              @map("phase_number")
  clusterId   Int              @map("cluster_id")
  cluster     Cluster          @relation(fields: [clusterId], references: [id])
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  allocations PhaseAllocation[]
  groups      Group[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, phaseNumber, clusterId])
}

model PhaseAllocation {
  id            Int         @id @default(autoincrement())
  phaseId       Int         @map("phase_id")
  phase         Phase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clusterId     Int         @map("cluster_id")
  cluster       Cluster     @relation(fields: [clusterId], references: [id])
  groupId       Int?        @map("group_id")
  group         Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([applicationId, phaseId])
}

model WaitlistEntry {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clusterId     Int         @map("cluster_id")
  status        String      @default("waiting")
  position      Int
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([clusterId, status, position])
}

model TransferRequest {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String      @default("transfer")
  fromClusterId Int         @map("from_cluster_id")
  toClusterId   Int?        @map("to_cluster_id")
  pref1New      Int?        @map("pref1_new")
  pref2New      Int?        @map("pref2_new")
  reason        String
  status        String      @default("pending")
  reviewNotes   String?     @map("review_notes")
  reviewedById  Int?        @map("reviewed_by_id")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
}

model Application {
  id               Int               @id @default(autoincrement())
  studentId        Int               @map("student_id")
  student          Student           @relation(fields: [studentId], references: [id])
  clusterPref1     Int               @map("cluster_pref_1")
  clusterPref2     Int               @map("cluster_pref_2")
  status           String            @default("pending")
  allocatedCluster Int?              @map("allocated_cluster")
  waitlistedAt     DateTime?         @map("waitlisted_at")
  reportUrl        String?           @map("report_url")
  submissionDate   DateTime          @default(now()) @map("submission_date")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  allocations      PhaseAllocation[]
  waitlistEntries  WaitlistEntry[]
  transferRequests TransferRequest[]
  weeklyReports    WeeklyReport[]

  @@unique([studentId])
}

model WeeklyReport {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  phaseNumber   Int         @map("phase_number")
  weekNumber    Int         @map("week_number")
  reportUrl     String      @map("report_url")
  originalName  String      @map("original_name")
  submittedAt   DateTime    @default(now()) @map("submitted_at")

  @@unique([applicationId, phaseNumber, weekNumber])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  type      String   @default("string")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  category  String   @default("general")
  subject   String
  body      String
  variables String   @default("[]")
  enabled   Boolean  @default(true)
  required  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  recipient String
  subject   String
  template  String?
  body      String?  @db.Text
  status    String   @default("pending")
  error     String?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  purpose   String
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
}

model Announcement {
  id             Int                  @id @default(autoincrement())
  clusterId      Int?                 @map("cluster_id")
  cluster        Cluster?             @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  staffId        Int?                 @map("staff_id")
  staff          Staff?               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title          String
  body           String
  audience       String               @default("students")
  attachmentUrl  String?              @map("attachment_url")
  attachmentName String?              @map("attachment_name")
  createdAt      DateTime             @default(now()) @map("created_at")
  reads          AnnouncementRead[]
  staffReads     StaffAnnouncementRead[]

  @@index([clusterId, createdAt])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int          @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  studentId      Int          @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, studentId])
}

model StaffAnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int          @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staffId        Int          @map("staff_id")
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, staffId])
}

model StaffTransferRequest {
  id           Int       @id @default(autoincrement())
  staffId      Int       @map("staff_id")
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fromClusterId Int      @map("from_cluster_id")
  fromCluster  Cluster   @relation("staffFromCluster", fields: [fromClusterId], references: [id], onDelete: Cascade, map: "StaffTransferRequest_from_cluster_fkey")
  toClusterId  Int       @map("to_cluster_id")
  toCluster    Cluster   @relation("staffToCluster", fields: [toClusterId], references: [id], onDelete: Cascade, map: "StaffTransferRequest_to_cluster_fkey")
  reason       String
  status       String    @default("pending")
  reviewNotes  String?   @map("review_notes")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
}

model Venue {
  id        Int      @id @default(autoincrement())
  clusterId Int      @map("cluster_id")
  cluster   Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  groups    Group[]

  @@unique([clusterId, name])
}

model Group {
  id          Int               @id @default(autoincrement())
  clusterId   Int               @map("cluster_id")
  cluster     Cluster           @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  phaseId     Int?              @map("phase_id")
  phase       Phase?            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  venueId     Int?              @map("venue_id")
  venue       Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  name        String
  location    String            @default("")
  capacity    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")
  allocations PhaseAllocation[]
}
